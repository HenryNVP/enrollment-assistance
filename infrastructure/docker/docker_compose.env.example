# ── Enrollment Assistant — unified .env ──────────────────────────────────
# Copy this file next to docker_compose.yml (infrastructure/docker/.env):
#
#   cp infrastructure/docker/docker_compose.env.example infrastructure/docker/.env
#   # fill in values below, then:
#   docker compose -f infrastructure/docker/docker_compose.yml up -d --build
#
# The same file works for local development and AWS (EC2/App Runner) — just
# adjust the values that differ (DB_HOST, service URLs, etc.).
# ─────────────────────────────────────────────────────────────────────────

# ── Secrets (required) ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Neo4j / Aura (required for rag_graph) ──────────────────────────────
# Aura (neo4j+s:// = TLS; username & database = Aura instance ID):
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=<instance-id>
NEO4J_PASSWORD=<aura-password>
NEO4J_DATABASE=<instance-id>
# Self-hosted (uncomment & adjust):
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=changeme
# NEO4J_DATABASE=

# ── Postgres (shared by rag_api + agent_api) ───────────────────────────
POSTGRES_DB=ragdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=55432

# ── RAG API ─────────────────────────────────────────────────────────────
RAG_HOST=0.0.0.0
RAG_PORT=8000
VECTOR_DB_TYPE=pgvector
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
COLLECTION_NAME=policy_docs
CHUNK_SIZE=500
CHUNK_OVERLAP=50
JWT_SECRET=change-me-shared-rag-secret

# ── Agent API ───────────────────────────────────────────────────────────
APP_ENV=development
PROJECT_NAME="Enrollment Assistant"
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_TEMPERATURE=0.2

# JWT (agent ↔ frontend auth)
JWT_SECRET_KEY=change-me-agent-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Agent → RAG auth (must match RAG API JWT_SECRET above)
RAG_JWT_SECRET=change-me-shared-rag-secret
RAG_JWT_ALGORITHM=HS256
RAG_JWT_TTL_SECONDS=300
RAG_SERVICE_SUBJECT=enrollment-assistant

# RAG search defaults
RAG_DEFAULT_FILE_IDS=policy_docs
RAG_TOP_K=5
RAG_ENTITY_ID=testuser
RAG_TIMEOUT_SECONDS=10

# Langfuse (optional observability)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://us.cloud.langfuse.com

# ── Host-port mapping (optional) ───────────────────────────────────────
# RAG_API_PORT=8010
# AGENT_API_PORT=8000
# RAG_GRAPH_PORT=8102
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# CADVISOR_PORT=8080
