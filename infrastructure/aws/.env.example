# ── Enrollment Assistant — AWS .env ──────────────────────────────────────
# Place this file at /opt/enrollment-assistant/.env on your EC2 instance.
#
# For EC2 + local Postgres:
#   docker compose -f docker-compose.ec2.yml up -d
#
# For EC2 + RDS:
#   docker compose -f docker-compose.ec2-rds.yml up -d
#
# ─────────────────────────────────────────────────────────────────────────
#
#  VARIABLE NAMING GUIDE
#  ─────────────────────
#  POSTGRES_HOST   → database hostname (used by agent_api)
#  DB_HOST         → same database hostname (used by rag_api — set by compose)
#  RAG_HOST        → rag_api HTTP bind address (always 0.0.0.0 — NOT a database)
#  RAG_BASE_URL    → agent_api → rag_api HTTP URL (set by compose, not here)
#
#  The compose files map POSTGRES_HOST → DB_HOST for rag_api, so you only
#  need to set POSTGRES_HOST once in this file.
# ─────────────────────────────────────────────────────────────────────────


# ── ECR Registry (required) ──────────────────────────────────────────────
# Where docker-compose pulls images from. No trailing slash.
ECR_REGISTRY=public.ecr.aws/f3z6z4g1/enrollment_assistance
# IMAGE_TAG=latest


# ══════════════════════════════════════════════════════════════════════════
# SECRETS (required)
# ══════════════════════════════════════════════════════════════════════════

OPENAI_API_KEY=sk-proj-...


# ══════════════════════════════════════════════════════════════════════════
# POSTGRES — shared by rag_api + agent_api
# ══════════════════════════════════════════════════════════════════════════
#
# EC2 + RDS example:
#   POSTGRES_HOST=enrollment-assistant-db.abc123.us-west-2.rds.amazonaws.com
#   POSTGRES_PORT=5432
#   POSTGRES_SSLMODE=require
#
# EC2 + local Postgres (docker-compose.ec2.yml — compose sets DB_HOST=db):
#   POSTGRES_HOST is ignored; compose hardcodes DB_HOST=db and POSTGRES_HOST=db
#   POSTGRES_PORT=5432

POSTGRES_HOST=enrollment-assistant-db.abc123.us-west-2.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-rds-password
POSTGRES_SSLMODE=require


# ══════════════════════════════════════════════════════════════════════════
# NEO4J / AURA — used by rag_graph service
# ══════════════════════════════════════════════════════════════════════════
#
# Neo4j Aura (neo4j+s:// = TLS; username & database = Aura instance ID):
NEO4J_URI=neo4j+s://abc12345.databases.neo4j.io
NEO4J_USERNAME=abc12345
NEO4J_PASSWORD=your-aura-password
NEO4J_DATABASE=abc12345
#
# Self-hosted Neo4j (uncomment & adjust):
# NEO4J_URI=bolt://neo4j-host:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=changeme
# NEO4J_DATABASE=


# ══════════════════════════════════════════════════════════════════════════
# RAG API — vector search service
# ══════════════════════════════════════════════════════════════════════════

VECTOR_DB_TYPE=pgvector
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
COLLECTION_NAME=policy_docs
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# JWT secret for authenticating requests TO rag_api (from agent_api or ingest scripts)
JWT_SECRET=change-me-to-a-real-secret


# ══════════════════════════════════════════════════════════════════════════
# AGENT API — LLM orchestrator
# ══════════════════════════════════════════════════════════════════════════

APP_ENV=production
PROJECT_NAME="Enrollment Assistant"
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_TEMPERATURE=0.2

# JWT for agent ↔ frontend authentication (can be different from JWT_SECRET)
JWT_SECRET_KEY=change-me-agent-frontend-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Agent → RAG API auth (MUST be identical to JWT_SECRET above!)
RAG_JWT_SECRET=change-me-to-a-real-secret
RAG_JWT_ALGORITHM=HS256
RAG_JWT_TTL_SECONDS=300

# RAG search defaults
RAG_QUERY_ENTITY_ID=public


# ══════════════════════════════════════════════════════════════════════════
# HOST-PORT MAPPING (optional — override defaults)
# ══════════════════════════════════════════════════════════════════════════
# RAG_API_PORT=8010       # rag_api exposed on EC2:8010
# AGENT_API_PORT=8000     # agent_api exposed on EC2:8000
# RAG_GRAPH_PORT=8102     # rag_graph exposed on EC2:8102


# ══════════════════════════════════════════════════════════════════════════
# OPTIONAL — Langfuse observability
# ══════════════════════════════════════════════════════════════════════════
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://us.cloud.langfuse.com
