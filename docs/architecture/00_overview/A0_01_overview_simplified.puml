@startuml A0_01_overview_simplified
title SJSU Enrollment Assistance – Simplified View

skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam packageStyle rectangle
skinparam rectangle {
  BorderColor #000000
  BorderThickness 1
}

rectangle "Client Layer" as CLIENT {
  rectangle "React Web App" as UI
}

package "Edge (optional in dev)" as EDGE {
  rectangle "Load balancer\n(L4/L7, TLS, health checks)" as LB
}

rectangle "Service Layer\n(Microservices)" as SERVICE {
  rectangle "Agent Service\norchestration, APIs, tools" as AGENT_SVC
  rectangle "RAG API\ndocuments, vector search" as RAG_SVC
  rectangle "Prerequisite Gateway (rag_graph)\nNeo4j prereqs / programs" as RAG_GRAPH_SVC
}

rectangle "Knowledge / Data Layer\n(Storage)" as KNOWLEDGE {
  rectangle "Relational DB\n(Postgres)\napp + enrollment data" as RDBMS
  rectangle "Vector Store\n(Postgres + pgvector)\ndocument embeddings" as VSTORE
  rectangle "Knowledge Graph\n(Neo4j)\nprerequisites + requirements" as KGRAPH
}

cloud "LLM Provider\n(OpenAI)" as LLM
cloud "Observability\n(Prometheus, Grafana, Langfuse)" as OBS

' Client → edge → Agent (public path)
UI --> LB : HTTPS
LB --> AGENT_SVC : /api/v1/*\n(chat, auth, doc proxy)

note bottom of LB
**Optional in dev:** clients may call\nAgent directly on :8000
end note

' Service to Service
AGENT_SVC --> RAG_SVC : policy search, doc processing
AGENT_SVC --> RAG_GRAPH_SVC : prereqs, program structure

' Service to Storage
AGENT_SVC --> RDBMS : sessions, checkpoints, users
RAG_SVC --> VSTORE : store/search vectors
RAG_GRAPH_SVC --> KGRAPH : read curriculum graph

' External
AGENT_SVC --> LLM : prompt completions
RAG_SVC --> LLM : embeddings
SERVICE --> OBS : metrics & traces

@enduml

